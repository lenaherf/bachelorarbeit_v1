# Copy to .env and replace placeholders. Never commit real credentials.

# Required only for live LLM extraction.
OPENAI_API_KEY=

# Neo4j connection (defaults match the included Docker Compose setup).
NEO4J_URI=bolt://localhost:7688
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-your-local-password
NEO4J_DATABASE=neo4j

# Used by Docker Compose; must match NEO4J_PASSWORD above.
PASS_NEO4J_PASSWORD=replace-with-your-local-password
