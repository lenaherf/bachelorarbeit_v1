<urn:swrl:var#x> rdf:type swrl:Variable .

<urn:swrl:var#y> rdf:type swrl:Variable .

<urn:swrl:var#z> rdf:type swrl:Variable .

<urn:swrl:var#s> rdf:type swrl:Variable .

<urn:swrl:var#r> rdf:type swrl:Variable .

<urn:swrl:var#b> rdf:type swrl:Variable .

<urn:swrl:var#t> rdf:type swrl:Variable .

<urn:swrl:var#a> rdf:type swrl:Variable .

<urn:swrl:var#st> rdf:type swrl:Variable .

[ rdf:type swrl:Imp ;
   swrl:body [ rdf:type swrl:AtomList ;
               rdf:first [ rdf:type swrl:ClassAtom ;
                           swrl:classPredicate standard-pass-ont:Action ;
                           swrl:argument1 <urn:swrl:var#x>
                         ] ;
               rdf:rest [ rdf:type swrl:AtomList ;
                          rdf:first [ rdf:type swrl:ClassAtom ;
                                      swrl:classPredicate standard-pass-ont:Transition ;
                                      swrl:argument1 <urn:swrl:var#y>
                                    ] ;
                          rdf:rest [ rdf:type swrl:AtomList ;
                                     rdf:first [ rdf:type swrl:ClassAtom ;
                                                 swrl:classPredicate standard-pass-ont:State ;
                                                 swrl:argument1 <urn:swrl:var#z>
                                               ] ;
                                     rdf:rest [ rdf:type swrl:AtomList ;
                                                rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                                                            swrl:propertyPredicate standard-pass-ont:contains ;
                                                            swrl:argument1 <urn:swrl:var#x> ;
                                                            swrl:argument2 <urn:swrl:var#y>
                                                          ] ;
                                                rdf:rest [ rdf:type swrl:AtomList ;
                                                           rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                                                                       swrl:propertyPredicate standard-pass-ont:contains ;
                                                                       swrl:argument1 <urn:swrl:var#x> ;
                                                                       swrl:argument2 <urn:swrl:var#z>
                                                                     ] ;
                                                           rdf:rest rdf:nil
                                                         ]
                                              ]
                                   ]
                        ]
             ] ;
   swrl:head [ rdf:type swrl:AtomList ;
               rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                           swrl:propertyPredicate standard-pass-ont:hasSourceState ;
                           swrl:argument1 <urn:swrl:var#y> ;
                           swrl:argument2 <urn:swrl:var#z>
                         ] ;
               rdf:rest [ rdf:type swrl:AtomList ;
                          rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                                      swrl:propertyPredicate standard-pass-ont:hasOutgoingTransition ;
                                      swrl:argument1 <urn:swrl:var#z> ;
                                      swrl:argument2 <urn:swrl:var#y>
                                    ] ;
                          rdf:rest rdf:nil
                        ]
             ]
 ] .

[ rdf:type swrl:Imp ;
   swrl:body [ rdf:type swrl:AtomList ;
               rdf:first [ rdf:type swrl:ClassAtom ;
                           swrl:classPredicate standard-pass-ont:State ;
                           swrl:argument1 <urn:swrl:var#x>
                         ] ;
               rdf:rest [ rdf:type swrl:AtomList ;
                          rdf:first [ rdf:type swrl:ClassAtom ;
                                      swrl:classPredicate standard-pass-ont:Transition ;
                                      swrl:argument1 <urn:swrl:var#y>
                                    ] ;
                          rdf:rest [ rdf:type swrl:AtomList ;
                                     rdf:first [ rdf:type swrl:ClassAtom ;
                                                 swrl:classPredicate standard-pass-ont:Action ;
                                                 swrl:argument1 <urn:swrl:var#z>
                                               ] ;
                                     rdf:rest [ rdf:type swrl:AtomList ;
                                                rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                                                            swrl:propertyPredicate standard-pass-ont:hasOutgoingTransition ;
                                                            swrl:argument1 <urn:swrl:var#x> ;
                                                            swrl:argument2 <urn:swrl:var#y>
                                                          ] ;
                                                rdf:rest [ rdf:type swrl:AtomList ;
                                                           rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                                                                       swrl:propertyPredicate standard-pass-ont:belongsTo ;
                                                                       swrl:argument1 <urn:swrl:var#x> ;
                                                                       swrl:argument2 <urn:swrl:var#z>
                                                                     ] ;
                                                           rdf:rest rdf:nil
                                                         ]
                                              ]
                                   ]
                        ]
             ] ;
   swrl:head [ rdf:type swrl:AtomList ;
               rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                           swrl:propertyPredicate standard-pass-ont:contains ;
                           swrl:argument1 <urn:swrl:var#z> ;
                           swrl:argument2 <urn:swrl:var#y>
                         ] ;
               rdf:rest rdf:nil
             ]
 ] .

[ rdf:type swrl:Imp ;
   swrl:body [ rdf:type swrl:AtomList ;
               rdf:first [ rdf:type swrl:ClassAtom ;
                           swrl:classPredicate standard-pass-ont:GuardBehavior ;
                           swrl:argument1 <urn:swrl:var#x>
                         ] ;
               rdf:rest [ rdf:type swrl:AtomList ;
                          rdf:first [ rdf:type swrl:ClassAtom ;
                                      swrl:classPredicate standard-pass-ont:SubjectBehavior ;
                                      swrl:argument1 <urn:swrl:var#y>
                                    ] ;
                          rdf:rest [ rdf:type swrl:AtomList ;
                                     rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                                                 swrl:propertyPredicate standard-pass-ont:guardsBehavior ;
                                                 swrl:argument1 <urn:swrl:var#x> ;
                                                 swrl:argument2 <urn:swrl:var#y>
                                               ] ;
                                     rdf:rest [ rdf:type swrl:AtomList ;
                                                rdf:first [ rdf:type swrl:ClassAtom ;
                                                            swrl:classPredicate standard-pass-ont:State ;
                                                            swrl:argument1 <urn:swrl:var#z>
                                                          ] ;
                                                rdf:rest [ rdf:type swrl:AtomList ;
                                                           rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                                                                       swrl:propertyPredicate standard-pass-ont:contains ;
                                                                       swrl:argument1 <urn:swrl:var#y> ;
                                                                       swrl:argument2 <urn:swrl:var#z>
                                                                     ] ;
                                                           rdf:rest rdf:nil
                                                         ]
                                              ]
                                   ]
                        ]
             ] ;
   swrl:head [ rdf:type swrl:AtomList ;
               rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                           swrl:propertyPredicate standard-pass-ont:guardsState ;
                           swrl:argument1 <urn:swrl:var#x> ;
                           swrl:argument2 <urn:swrl:var#z>
                         ] ;
               rdf:rest rdf:nil
             ]
 ] .

[ rdf:type swrl:Imp ;
   swrl:body [ rdf:type swrl:AtomList ;
               rdf:first [ rdf:type swrl:ClassAtom ;
                           swrl:classPredicate standard-pass-ont:ReceiveTransitionCondition ;
                           swrl:argument1 <urn:swrl:var#x>
                         ] ;
               rdf:rest [ rdf:type swrl:AtomList ;
                          rdf:first [ rdf:type swrl:ClassAtom ;
                                      swrl:classPredicate standard-pass-ont:MessageSpecification ;
                                      swrl:argument1 <urn:swrl:var#y>
                                    ] ;
                          rdf:rest [ rdf:type swrl:AtomList ;
                                     rdf:first [ rdf:type swrl:ClassAtom ;
                                                 swrl:classPredicate standard-pass-ont:Subject ;
                                                 swrl:argument1 <urn:swrl:var#s>
                                               ] ;
                                     rdf:rest [ rdf:type swrl:AtomList ;
                                                rdf:first [ rdf:type swrl:ClassAtom ;
                                                            swrl:classPredicate standard-pass-ont:Subject ;
                                                            swrl:argument1 <urn:swrl:var#r>
                                                          ] ;
                                                rdf:rest [ rdf:type swrl:AtomList ;
                                                           rdf:first [ rdf:type swrl:ClassAtom ;
                                                                       swrl:classPredicate standard-pass-ont:SubjectBehavior ;
                                                                       swrl:argument1 <urn:swrl:var#b>
                                                                     ] ;
                                                           rdf:rest [ rdf:type swrl:AtomList ;
                                                                      rdf:first [ rdf:type swrl:ClassAtom ;
                                                                                  swrl:classPredicate standard-pass-ont:ReceiveTransition ;
                                                                                  swrl:argument1 <urn:swrl:var#t>
                                                                                ] ;
                                                                      rdf:rest [ rdf:type swrl:AtomList ;
                                                                                 rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                                                                                             swrl:propertyPredicate standard-pass-ont:containsBehavior ;
                                                                                             swrl:argument1 <urn:swrl:var#r> ;
                                                                                             swrl:argument2 <urn:swrl:var#b>
                                                                                           ] ;
                                                                                 rdf:rest [ rdf:type swrl:AtomList ;
                                                                                            rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                                                                                                        swrl:propertyPredicate standard-pass-ont:contains ;
                                                                                                        swrl:argument1 <urn:swrl:var#b> ;
                                                                                                        swrl:argument2 <urn:swrl:var#t>
                                                                                                      ] ;
                                                                                            rdf:rest [ rdf:type swrl:AtomList ;
                                                                                                       rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                                                                                                                   swrl:propertyPredicate standard-pass-ont:hasTransitionCondition ;
                                                                                                                   swrl:argument1 <urn:swrl:var#t> ;
                                                                                                                   swrl:argument2 <urn:swrl:var#x>
                                                                                                                 ] ;
                                                                                                       rdf:rest [ rdf:type swrl:AtomList ;
                                                                                                                  rdf:first [ rdf:type swrl:ClassAtom ;
                                                                                                                              swrl:classPredicate standard-pass-ont:MessageExchange ;
                                                                                                                              swrl:argument1 <urn:swrl:var#a>
                                                                                                                            ] ;
                                                                                                                  rdf:rest [ rdf:type swrl:AtomList ;
                                                                                                                             rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                                                                                                                                         swrl:propertyPredicate standard-pass-ont:hasSender ;
                                                                                                                                         swrl:argument1 <urn:swrl:var#a> ;
                                                                                                                                         swrl:argument2 <urn:swrl:var#s>
                                                                                                                                       ] ;
                                                                                                                             rdf:rest [ rdf:type swrl:AtomList ;
                                                                                                                                        rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                                                                                                                                                    swrl:propertyPredicate standard-pass-ont:hasMessageType ;
                                                                                                                                                    swrl:argument1 <urn:swrl:var#a> ;
                                                                                                                                                    swrl:argument2 <urn:swrl:var#y>
                                                                                                                                                  ] ;
                                                                                                                                        rdf:rest [ rdf:type swrl:AtomList ;
                                                                                                                                                   rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                                                                                                                                                               swrl:propertyPredicate standard-pass-ont:requiresPerformedMessageExchange ;
                                                                                                                                                               swrl:argument1 <urn:swrl:var#x> ;
                                                                                                                                                               swrl:argument2 <urn:swrl:var#a>
                                                                                                                                                             ] ;
                                                                                                                                                   rdf:rest rdf:nil
                                                                                                                                                 ]
                                                                                                                                      ]
                                                                                                                           ]
                                                                                                                ]
                                                                                                     ]
                                                                                          ]
                                                                               ]
                                                                    ]
                                                         ]
                                              ]
                                   ]
                        ]
             ] ;
   swrl:head [ rdf:type swrl:AtomList ;
               rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                           swrl:propertyPredicate standard-pass-ont:requiresReceptionOfMessage ;
                           swrl:argument1 <urn:swrl:var#x> ;
                           swrl:argument2 <urn:swrl:var#y>
                         ] ;
               rdf:rest [ rdf:type swrl:AtomList ;
                          rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                                      swrl:propertyPredicate standard-pass-ont:requiresMessageSentFrom ;
                                      swrl:argument1 <urn:swrl:var#x> ;
                                      swrl:argument2 <urn:swrl:var#s>
                                    ] ;
                          rdf:rest rdf:nil
                        ]
             ]
 ] .

[ rdf:type swrl:Imp ;
   swrl:body [ rdf:type swrl:AtomList ;
               rdf:first [ rdf:type swrl:ClassAtom ;
                           swrl:classPredicate standard-pass-ont:SendTransitionCondition ;
                           swrl:argument1 <urn:swrl:var#x>
                         ] ;
               rdf:rest [ rdf:type swrl:AtomList ;
                          rdf:first [ rdf:type swrl:ClassAtom ;
                                      swrl:classPredicate standard-pass-ont:MessageSpecification ;
                                      swrl:argument1 <urn:swrl:var#y>
                                    ] ;
                          rdf:rest [ rdf:type swrl:AtomList ;
                                     rdf:first [ rdf:type swrl:ClassAtom ;
                                                 swrl:classPredicate standard-pass-ont:Subject ;
                                                 swrl:argument1 <urn:swrl:var#s>
                                               ] ;
                                     rdf:rest [ rdf:type swrl:AtomList ;
                                                rdf:first [ rdf:type swrl:ClassAtom ;
                                                            swrl:classPredicate standard-pass-ont:SubjectBehavior ;
                                                            swrl:argument1 <urn:swrl:var#b>
                                                          ] ;
                                                rdf:rest [ rdf:type swrl:AtomList ;
                                                           rdf:first [ rdf:type swrl:ClassAtom ;
                                                                       swrl:classPredicate standard-pass-ont:SendTransition ;
                                                                       swrl:argument1 <urn:swrl:var#t>
                                                                     ] ;
                                                           rdf:rest [ rdf:type swrl:AtomList ;
                                                                      rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                                                                                  swrl:propertyPredicate standard-pass-ont:containsBehavior ;
                                                                                  swrl:argument1 <urn:swrl:var#s> ;
                                                                                  swrl:argument2 <urn:swrl:var#b>
                                                                                ] ;
                                                                      rdf:rest [ rdf:type swrl:AtomList ;
                                                                                 rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                                                                                             swrl:propertyPredicate standard-pass-ont:contains ;
                                                                                             swrl:argument1 <urn:swrl:var#b> ;
                                                                                             swrl:argument2 <urn:swrl:var#t>
                                                                                           ] ;
                                                                                 rdf:rest [ rdf:type swrl:AtomList ;
                                                                                            rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                                                                                                        swrl:propertyPredicate standard-pass-ont:hasTransitionCondition ;
                                                                                                        swrl:argument1 <urn:swrl:var#t> ;
                                                                                                        swrl:argument2 <urn:swrl:var#x>
                                                                                                      ] ;
                                                                                            rdf:rest [ rdf:type swrl:AtomList ;
                                                                                                       rdf:first [ rdf:type swrl:ClassAtom ;
                                                                                                                   swrl:classPredicate standard-pass-ont:Subject ;
                                                                                                                   swrl:argument1 <urn:swrl:var#r>
                                                                                                                 ] ;
                                                                                                       rdf:rest [ rdf:type swrl:AtomList ;
                                                                                                                  rdf:first [ rdf:type swrl:ClassAtom ;
                                                                                                                              swrl:classPredicate standard-pass-ont:MessageExchange ;
                                                                                                                              swrl:argument1 <urn:swrl:var#a>
                                                                                                                            ] ;
                                                                                                                  rdf:rest [ rdf:type swrl:AtomList ;
                                                                                                                             rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                                                                                                                                         swrl:propertyPredicate standard-pass-ont:hasReceiver ;
                                                                                                                                         swrl:argument1 <urn:swrl:var#a> ;
                                                                                                                                         swrl:argument2 <urn:swrl:var#r>
                                                                                                                                       ] ;
                                                                                                                             rdf:rest [ rdf:type swrl:AtomList ;
                                                                                                                                        rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                                                                                                                                                    swrl:propertyPredicate standard-pass-ont:hasMessageType ;
                                                                                                                                                    swrl:argument1 <urn:swrl:var#a> ;
                                                                                                                                                    swrl:argument2 <urn:swrl:var#y>
                                                                                                                                                  ] ;
                                                                                                                                        rdf:rest [ rdf:type swrl:AtomList ;
                                                                                                                                                   rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                                                                                                                                                               swrl:propertyPredicate standard-pass-ont:requiresPerformedMessageExchange ;
                                                                                                                                                               swrl:argument1 <urn:swrl:var#x> ;
                                                                                                                                                               swrl:argument2 <urn:swrl:var#a>
                                                                                                                                                             ] ;
                                                                                                                                                   rdf:rest rdf:nil
                                                                                                                                                 ]
                                                                                                                                      ]
                                                                                                                           ]
                                                                                                                ]
                                                                                                     ]
                                                                                          ]
                                                                               ]
                                                                    ]
                                                         ]
                                              ]
                                   ]
                        ]
             ] ;
