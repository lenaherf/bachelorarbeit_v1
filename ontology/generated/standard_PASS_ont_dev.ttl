###  http://www.i2pm.net/standard-pass-ont#InputPoolConstraintStrategy-DeleteOldest
standard-pass-ont:InputPoolConstraintStrategy-DeleteOldest rdf:type owl:NamedIndividual ,
                                                                    standard-pass-ont:InputPoolContstraintHandlingStrategy .


###  http://www.i2pm.net/standard-pass-ont#InputPoolConstraintStrategy-Drop
standard-pass-ont:InputPoolConstraintStrategy-Drop rdf:type owl:NamedIndividual ,
                                                            standard-pass-ont:InputPoolContstraintHandlingStrategy .


###  http://www.i2pm.net/standard-pass-ont#ReceiveTypeMultiReceiveFromAllKnown
standard-pass-ont:ReceiveTypeMultiReceiveFromAllKnown rdf:type owl:NamedIndividual ,
                                                               standard-pass-ont:ReceiveType .


###  http://www.i2pm.net/standard-pass-ont#ReceiveTypeMultiReceiveFromKnwon
standard-pass-ont:ReceiveTypeMultiReceiveFromKnwon rdf:type owl:NamedIndividual ,
                                                            standard-pass-ont:ReceiveType .


###  http://www.i2pm.net/standard-pass-ont#ReceiveTypeStandard
standard-pass-ont:ReceiveTypeStandard rdf:type owl:NamedIndividual ,
                                               standard-pass-ont:ReceiveType .


###  http://www.i2pm.net/standard-pass-ont#SendTypeMultiSendToAll
standard-pass-ont:SendTypeMultiSendToAll rdf:type owl:NamedIndividual ,
                                                  standard-pass-ont:SendType .


###  http://www.i2pm.net/standard-pass-ont#SendTypeMultiSendToKnown
standard-pass-ont:SendTypeMultiSendToKnown rdf:type owl:NamedIndividual ,
                                                    standard-pass-ont:SendType .


###  http://www.i2pm.net/standard-pass-ont#SendTypeMultiSendToNew
